# Copie estes nomes em Vercel > Project Settings > Environment Variables.
# Não versionar valores reais.
AUTH_MODE=external
DATABASE_URL=mysql://USUARIO:SENHA@HOST:4000/richesse_bi?ssl={}
JWT_SECRET=gere-uma-chave-aleatoria-longa
ADMIN_EMAIL=seu-email-administrativo
ADMIN_PASSWORD=senha-administrativa-forte
VITE_AUTH_MODE=external
STORAGE_MODE=vercel-blob
BLOB_READ_WRITE_TOKEN=token-criado-na-integracao-vercel-blob
